	(text "1. Module pin orders follow common clones. Wire by the labels printed on YOUR boards."
		(exclude_from_sim no)
		(at 114.3 145.542 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "892f4f88-9bb8-433f-b808-68973165568e")
	)
	(text "2. Battery sense: BAT_ADC = VSW / 2  (4.2V full -> 2.1V, 3.3V empty -> 1.65V) on GPIO0 (ADC1)."
		(exclude_from_sim no)
		(at 114.3 148.844 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "daa382ea-25c9-4d97-b3a9-f4db5be66991")
	)
	(text "3. Buttons use INPUT_PULLUP; GPIO3/4/5 can wake the ESP32-C3 from deep sleep (GPIO0-5 only)."
		(exclude_from_sim no)
		(at 114.3 152.146 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "275090db-1b16-47a5-b9cb-b68ec4a1416b")
	)
	(text "4. GPIO2/8/9 are strapping pins and are left unused. GPIO8 also drives the onboard LED."
		(exclude_from_sim no)
		(at 114.3 155.448 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "790bc4a7-0fa0-4995-a726-98a8ec6d18b4")
	)
	(text "5. Charge through the TP4056's USB-C. D1 drops ~0.3V, so the ESP32's LDO runs down to ~3.6V cell."
		(exclude_from_sim no)
		(at 114.3 158.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "32d7e170-a4d9-4df5-95aa-d3be0af37f32")
	)
	(text "6. LiPo safety: never puncture, bend or short the cell. Keep the DW01-protected TP4056 module."
		(exclude_from_sim no)
		(at 114.3 162.052 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9f1f352f-2489-4bc3-b64d-096d4fb819e1")
	)
